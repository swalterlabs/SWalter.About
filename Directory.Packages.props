<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <Choose>
    <!-- #region Project Libs -->
    <When Condition="$(MSBuildProjectName.EndsWith('.Core'))">
      <ItemGroup>
        <PackageVersion Include="SWalter.Core" Version="2026.11.10.18" />
        <PackageVersion Include="SWalter.Core.DependencyInjection" Version="2026.11.10.18" />
      </ItemGroup>
    </When>
    <When Condition="$(MSBuildProjectName.EndsWith('.Avalonia'))">
      <ItemGroup>
        <PackageVersion Include="SWalter.Core.Avalonia" Version="2026.11.10.19" />
      </ItemGroup>
    </When>
    <When Condition="$(MSBuildProjectName.EndsWith('.Terminal'))">
      <ItemGroup>
        <PackageVersion Include="Spectre.Console" Version="0.57.2" />
      </ItemGroup>
    </When>
    <!-- #endregion Project Libs -->
    <!-- #region Unit Test Libs -->
    <When Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
      <ItemGroup>
        <PackageVersion Include="coverlet.collector" Version="10.1.0" />
        <PackageVersion Include="SWalter.Testing" Version="2026.11.10.17" />
        <PackageVersion Include="AwesomeAssertions.Analyzers" Version="9.0.8" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
        <PackageVersion Include="xunit.v3" Version="4.0.3" />
        <PackageVersion Include="xunit.analyzers" Version="2.3.0" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
      </ItemGroup>
    </When>
    <!-- #endregion Unit Test Libs -->
  </Choose>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.13" />
  </ItemGroup>
</Project>